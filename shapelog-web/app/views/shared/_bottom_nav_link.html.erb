<% active = current_page?(path) %>
<%= link_to path,
    class: "group flex flex-col items-center justify-center gap-1 rounded-xl px-2 text-[11px] font-medium transition-colors #{active ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-500 dark:text-slate-400'}" do %>
  <span class="flex h-9 w-9 items-center justify-center rounded-xl #{active ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400' : 'bg-transparent text-slate-500 group-hover:bg-slate-100 dark:text-slate-400 dark:group-hover:bg-slate-800'}"><%= icon %></span>
  <span><%= label %></span>
<% end %>
