<% if record.errors.any? %>
  <div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 shadow-xs dark:border-rose-800 dark:bg-rose-900/20">
    <h3 class="mb-2 text-sm font-semibold text-rose-800 dark:text-rose-300">
      <%= pluralize(record.errors.count, "erro") %> impediram o salvamento:
    </h3>
    <ul class="list-disc list-inside space-y-1">
      <% record.errors.full_messages.each do |message| %>
        <li class="text-sm text-rose-700 dark:text-rose-400"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
