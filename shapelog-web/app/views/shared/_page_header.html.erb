<div class="mb-6 flex items-start justify-between gap-4">
  <div class="min-w-0">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400"><%= subtitle %></p>
    <% end %>
  </div>
  <% if local_assigns[:action].present? %>
    <div class="shrink-0"><%= action %></div>
  <% end %>
</div>
