<% active = current_page?(path) %>
<%= link_to path,
    class: "group flex items-center gap-3 rounded-xl border px-3 py-2.5 text-sm font-medium transition-colors #{active ? 'border-emerald-200 bg-emerald-50 text-emerald-700 shadow-xs dark:border-emerald-900 dark:bg-emerald-900/20 dark:text-emerald-300' : 'border-transparent text-slate-700 hover:border-slate-200 hover:bg-slate-50 dark:text-slate-300 dark:hover:border-slate-800 dark:hover:bg-slate-800/70'}" do %>
  <span class="flex h-9 w-9 items-center justify-center rounded-lg #{active ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300' : 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400'}"><%= icon %></span>
  <span class="truncate"><%= label %></span>
<% end %>
