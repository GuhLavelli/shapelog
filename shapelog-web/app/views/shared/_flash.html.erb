<% flash.each do |type, message| %>
  <% classes = type.to_s == "alert" ? "bg-rose-50 border-rose-200 text-rose-800 dark:bg-rose-900/20 dark:border-rose-800 dark:text-rose-300" : "bg-[#e0e7ff] border-[#6366f1]/30 text-[#4f46e5] dark:bg-indigo-900/20 dark:border-indigo-800 dark:text-indigo-300" %>
  <div class="mb-4 rounded-lg border px-4 py-3 text-sm <%= classes %>">
    <%= message %>
  </div>
<% end %>
