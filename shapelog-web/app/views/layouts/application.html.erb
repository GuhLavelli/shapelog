<!DOCTYPE html>
<html class="h-full" data-controller="dark-mode">
  <head>
    <title><%= content_for(:title) || "ShapeLog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ShapeLog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans antialiased">
    <% if authenticated? %>
      <%# ── Sidebar Desktop ── %>
      <div class="hidden md:fixed md:inset-y-0 md:flex md:w-64 md:flex-col">
        <div class="flex min-h-0 flex-1 flex-col bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800">
          <div class="flex flex-1 flex-col overflow-y-auto pt-6 pb-4">
            <%# Logo %>
            <div class="flex items-center gap-2 px-4 mb-8">
              <span class="text-2xl">🏋️</span>
              <span class="text-xl font-bold text-[#10b981]">ShapeLog</span>
            </div>

            <%# Nav links %>
            <nav class="flex-1 space-y-1 px-3">
              <%= render "shared/nav_link", path: root_path, label: "Dashboard", icon: "📊" %>
              <%= render "shared/nav_link", path: daily_checkins_path, label: "Check-ins", icon: "📝" %>
              <%= render "shared/nav_link", path: weights_path, label: "Peso", icon: "⚖️" %>
              <%= render "shared/nav_link", path: mounjaro_applications_path, label: "Mounjaro", icon: "💉" %>
              <%= render "shared/nav_link", path: body_measurements_path, label: "Medidas", icon: "📏" %>
              <%= render "shared/nav_link", path: goal_path, label: "Meta", icon: "🎯" %>
            </nav>
          </div>

          <%# Sair %>
          <div class="border-t border-slate-200 dark:border-slate-800 p-4">
            <%= button_to "Sair", session_path, method: :delete,
                class: "w-full text-left text-sm text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 transition-colors" %>
          </div>
        </div>
      </div>

      <%# ── Conteúdo principal ── %>
      <div class="md:pl-64 flex flex-col flex-1 min-h-screen">
        <%# Header superior %>
        <header class="sticky top-0 z-10 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
          <div class="flex h-14 items-center justify-between px-4 sm:px-6">
            <p class="text-sm text-slate-500 dark:text-slate-400">
              Olá, <span class="font-medium text-slate-900 dark:text-slate-100">Gustavo</span>
            </p>
            <button data-action="click->dark-mode#toggle"
                    class="rounded-lg p-2 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                    title="Alternar dark mode">
              <span data-dark-mode-target="icon">🌙</span>
            </button>
          </div>
        </header>

        <%# Flash messages %>
        <div class="px-4 sm:px-6 pt-4">
          <%= render "shared/flash" %>
        </div>

        <%# Yield %>
        <main class="flex-1 px-4 sm:px-6 pb-24 md:pb-6 pt-2">
          <%= yield %>
        </main>
      </div>

      <%# ── Bottom Nav Mobile ── %>
      <nav class="md:hidden fixed bottom-0 left-0 right-0 z-20 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800">
        <div class="grid grid-cols-4 h-16">
          <%= render "shared/bottom_nav_link", path: root_path, label: "Dashboard", icon: "📊" %>
          <%= render "shared/bottom_nav_link", path: daily_checkins_path, label: "Check-ins", icon: "📝" %>
          <%= render "shared/bottom_nav_link", path: weights_path, label: "Peso", icon: "⚖️" %>
          <%= render "shared/bottom_nav_link", path: mounjaro_applications_path, label: "Mais", icon: "⋯" %>
        </div>
      </nav>

    <% else %>
      <%# Layout simples para tela de login %>
      <div class="min-h-screen flex items-center justify-center">
        <div class="w-full max-w-sm">
          <div class="text-center mb-8">
            <span class="text-5xl">🏋️</span>
            <h1 class="mt-3 text-2xl font-bold text-slate-900 dark:text-slate-100">ShapeLog</h1>
          </div>
          <%= yield %>
        </div>
      </div>
    <% end %>
  </body>
</html>
