# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/apps/web/log/*
/apps/web/tmp/*
!/apps/web/log/.keep
!/apps/web/tmp/.keep
log/
tmp/
**/log/
**/tmp/


# Ignore pidfiles, but keep the directory.
/apps/web/tmp/pids/*
!/apps/web/tmp/pids/
!/apps/web/tmp/pids/.keep

/apps/web/public/assets

# Ignore key files for decrypting credentials and more.
/apps/web/config/*.key

# Ignore local Claude Code settings (machine-specific paths and permissions)
/.claude/
/.codex
/.nvimlog

# JavaScript dependencies are installed locally but should not be versioned.
node_modules/
**/node_modules/

/apps/web/app/assets/builds/*
!/apps/web/app/assets/builds/.keep
