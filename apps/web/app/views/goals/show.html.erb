<%= render "shared/page_header",
    title: "Meta",
    subtitle: "Acompanhe a direção e o progresso da sua jornada",
    action: link_to((@goal.new_record? ? "Definir meta" : "Editar"), edit_goal_path, class: button_classes(variant: :primary)) %>

<% if @goal.new_record? %>
  <%= render "shared/card" do %>
    <%= render "shared/empty_state",
        title: "Você ainda não tem uma meta definida",
        description: "Defina peso inicial, peso alvo e ritmo semanal para acompanhar sua evolução.",
        cta_label: "Definir meta",
        cta_path: edit_goal_path,
        icon: "🎯" %>
  <% end %>
<% else %>
  <div class="space-y-6">
    <%= render "shared/card" do %>
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Objetivo</p>
          <div class="mt-2 flex items-center gap-3 text-2xl font-bold text-slate-900 dark:text-slate-100">
            <span><%= number_with_precision(@goal.starting_weight, precision: 1, strip_insignificant_zeros: true) %> kg</span>
            <span class="text-slate-400">→</span>
            <span><%= number_with_precision(@goal.target_weight, precision: 1, strip_insignificant_zeros: true) %> kg</span>
          </div>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400"><%= goal_direction_label(@goal) %></p>
        </div>

        <div class="md:text-right">
          <p class="text-sm font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Peso atual médio</p>
          <p class="mt-2 text-2xl font-bold text-slate-900 dark:text-slate-100">
            <%= @current_weight_average.present? ? "#{number_with_precision(@current_weight_average, precision: 1, strip_insignificant_zeros: true)} kg" : "—" %>
          </p>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Média móvel dos últimos 7 check-ins</p>
        </div>
      </div>

      <div class="mt-6">
        <div class="h-3 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
          <% if @progress_percent.present? %>
            <div class="h-full rounded-full bg-emerald-500 transition-all" style="width: <%= percentage_width(@progress_percent) %>%"></div>
          <% end %>
        </div>
        <p class="mt-3 text-sm font-medium text-slate-700 dark:text-slate-300">
          <% if @progress_percent.present? %>
            <%= number_with_precision(@progress_percent, precision: 1, strip_insignificant_zeros: true) %>% do caminho
          <% else %>
            Sem dados suficientes para calcular o progresso
          <% end %>
        </p>
      </div>
    <% end %>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
      <%= render "shared/stat_tile",
          label: "Mudança total",
          value: "#{number_with_precision(@goal.total_change_needed, precision: 1, strip_insignificant_zeros: true)} kg" %>
      <%= render "shared/stat_tile",
          label: "Meta semanal",
          value: @goal.weekly_target.present? ? "#{number_with_precision(@goal.weekly_target, precision: 1, strip_insignificant_zeros: true)} kg/semana" : "—" %>
      <%= render "shared/stat_tile",
          label: "Semanas restantes",
          value: @estimated_weeks_remaining.present? ? @estimated_weeks_remaining : "—" %>
      <%= render "shared/stat_tile",
          label: "Data inicial",
          value: l(@goal.start_date, format: :long) %>
    </div>
  </div>
<% end %>
