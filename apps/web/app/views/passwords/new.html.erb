<%= render "shared/page_header",
    title: "Recuperar senha",
    subtitle: "Informe seu e-mail para receber o link de redefinição." %>

<%= form_with url: passwords_path, class: "space-y-5" do |form| %>
  <% email_field_id = form.field_id(:email_address) %>

  <%= render "shared/field",
      field_id: email_field_id,
      label_text: "E-mail",
      required: true,
      hint: "Se o endereço existir, enviaremos um link para redefinir a senha." do %>
    <%= form.email_field :email_address,
        id: email_field_id,
        required: true,
        autofocus: true,
        autocomplete: "username",
        placeholder: "voce@exemplo.com",
        value: params[:email_address],
        class: "block w-full rounded-xl border border-slate-300 bg-slate-50 p-3 text-sm text-slate-900 shadow-xs focus:border-emerald-500 focus:ring-emerald-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder-slate-500" %>
  <% end %>

  <div class="flex flex-col gap-3 border-t border-slate-200 pt-5 dark:border-slate-800">
    <%= form.submit "Enviar instruções",
        class: "inline-flex w-full items-center justify-center rounded-lg border border-emerald-600 bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:border-emerald-700 hover:bg-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-300 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:border-emerald-600 dark:hover:bg-emerald-600 dark:focus:ring-emerald-800" %>

    <%= link_to "Voltar para o login",
        new_session_path,
        class: "inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 focus:outline-none focus:ring-4 focus:ring-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700 dark:focus:ring-slate-700" %>
  </div>
<% end %>
