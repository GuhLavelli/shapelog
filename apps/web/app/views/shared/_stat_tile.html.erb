<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
  <p class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= label %></p>
  <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100"><%= value.presence || "—" %></p>
  <% if local_assigns[:delta].present? %>
    <% delta_positive = delta.to_s.start_with?("+") || (delta.respond_to?(:positive?) && delta.positive?) %>
    <p class="mt-2 text-sm font-medium <%= delta_positive ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-500 dark:text-rose-400' %>">
      <%= delta %>
      <% if local_assigns[:hint].present? %>
        <span class="font-normal text-slate-400"><%= hint %></span>
      <% end %>
    </p>
  <% end %>
</div>
