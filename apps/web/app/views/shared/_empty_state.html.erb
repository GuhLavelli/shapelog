<div class="rounded-2xl border border-dashed border-slate-300 bg-white/70 px-6 py-16 text-center dark:border-slate-700 dark:bg-slate-900/60">
  <div class="mb-4 text-5xl"><%= local_assigns[:icon] || "📭" %></div>
  <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100"><%= title %></h3>
  <% if local_assigns[:description].present? %>
    <p class="mx-auto mt-2 max-w-md text-sm text-slate-500 dark:text-slate-400"><%= description %></p>
  <% end %>
  <% if local_assigns[:cta_label].present? && local_assigns[:cta_path].present? %>
    <div class="mt-6">
      <%= link_to cta_label, cta_path,
          class: "inline-flex items-center justify-center rounded-lg border border-emerald-600 bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-emerald-700 hover:border-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-300 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-600 dark:hover:border-emerald-600 dark:focus:ring-emerald-800" %>
    </div>
  <% end %>
</div>
