<%= render "shared/page_header",
    title: "Check-ins",
    subtitle: "Registre peso, consistência e como o dia respondeu.",
    action: link_to("Novo check-in", new_daily_checkin_path, class: button_classes(variant: :primary)) %>

<div class="space-y-6">
  <%= render "today_checkin", today_checkin: @today_checkin %>

  <% if @checkins.any? %>
    <% @checkins.group_by { |checkin| checkin.date.beginning_of_week }.each do |week_start, week_checkins| %>
      <%= render "shared/card" do %>
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Semana</p>
              <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100"><%= l(week_start, format: :long) %></h2>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400">
              <span class="font-medium text-slate-900 dark:text-slate-100"><%= week_checkins.count(&:trained?) %>/7</span> dias com treino
            </p>
          </div>

          <div class="space-y-3">
            <% week_checkins.each do |checkin| %>
              <%= link_to edit_daily_checkin_path(checkin), class: "block rounded-2xl border border-slate-200 bg-slate-50/60 p-4 transition hover:border-emerald-300 hover:bg-white dark:border-slate-800 dark:bg-slate-950/40 dark:hover:border-emerald-800 dark:hover:bg-slate-950/70" do %>
                <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                  <div>
                    <div class="flex flex-wrap items-center gap-3">
                      <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100"><%= l(checkin.date, format: :long) %></h3>
                      <span class="text-sm text-slate-500 dark:text-slate-400"><%= checkin.weight %> kg</span>
                    </div>

                    <div class="mt-3 flex flex-wrap gap-2 text-xs font-medium">
                      <span class="<%= status_badge_classes(active: checkin.trained?) %>">Treino</span>
                      <span class="<%= status_badge_classes(active: checkin.cardio?) %>">Cardio</span>
                      <span class="<%= status_badge_classes(active: checkin.anxiolytic_used?, tone: :warning) %>">Ansiolítico</span>
                    </div>
                  </div>

                  <div class="grid grid-cols-3 gap-3 lg:min-w-[20rem]">
                    <% [
                      ["Fome", checkin.hunger_level],
                      ["Energia", checkin.energy_level],
                      ["Humor/Stress", checkin.mood_stress_level]
                    ].each do |label, value| %>
                      <div>
                        <div class="mb-1 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                          <span><%= label %></span>
                          <span><%= value || "—" %></span>
                        </div>
                        <div class="h-2 rounded-full bg-slate-100 dark:bg-slate-800">
                          <div class="h-2 rounded-full bg-emerald-500" style="width: <%= percentage_width(value, max: 10) %>%"></div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>

                <% if checkin.notes.present? %>
                  <p class="mt-3 text-sm text-slate-500 dark:text-slate-400"><%= truncate(checkin.notes, length: 120) %></p>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <%= render "shared/empty_state",
        icon: "📝",
        title: "Nenhum check-in registrado",
        description: "Comece pelo check-in de hoje para alimentar dashboard, evolução de peso e consistência.",
        cta_label: "Registrar primeiro check-in",
        cta_path: new_daily_checkin_path(date: Date.current) %>
  <% end %>
</div>
